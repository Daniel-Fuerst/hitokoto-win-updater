# Version derivation from git describe (vMAJOR.MINOR.PATCH), following hitokoto ADR 0010.

function(updater_version_from_describe describe full_var core_var)
    set(full "")
    set(core "")
    if(describe MATCHES "^v((0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*))(-([0-9]+)-g([0-9a-f]+))?(-dirty)?$")
        set(core "${CMAKE_MATCH_1}")
        set(meta "")
        if(NOT "${CMAKE_MATCH_5}" STREQUAL "")
            set(meta "${CMAKE_MATCH_6}.g${CMAKE_MATCH_7}")
        endif()
        if(NOT "${CMAKE_MATCH_8}" STREQUAL "")
            if("${meta}" STREQUAL "")
                set(meta "dirty")
            else()
                string(APPEND meta ".dirty")
            endif()
        endif()
        set(full "${core}")
        if(NOT "${meta}" STREQUAL "")
            string(APPEND full "+${meta}")
        endif()
    endif()
    set(${full_var} "${full}" PARENT_SCOPE)
    set(${core_var} "${core}" PARENT_SCOPE)
endfunction()

function(updater_version_from_option value full_var core_var)
    set(full "")
    set(core "")
    set(id "[0-9A-Za-z-]+")
    if(value MATCHES "^((0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*))(-${id}(\\.${id})*)?(\\+${id}(\\.${id})*)?$")
        set(full "${value}")
        set(core "${CMAKE_MATCH_1}")
    endif()
    set(${full_var} "${full}" PARENT_SCOPE)
    set(${core_var} "${core}" PARENT_SCOPE)
endfunction()

function(updater_determine_version)
    if(POLICY CMP0174)
        cmake_policy(SET CMP0174 NEW)
    endif()
    cmake_parse_arguments(PARSE_ARGV 0 a "NO_GIT" "SOURCE_DIR;OPTION;FULL;CORE;WARNING;SOURCE" "")

    set(git_full "")
    set(git_core "")
    set(git_problem "")
    set(git "")
    if(NOT a_NO_GIT)
        find_package(Git QUIET)
        if(GIT_FOUND)
            set(git "${GIT_EXECUTABLE}")
        endif()
    endif()
    if("${git}" STREQUAL "")
        set(git_problem "git not found")
    elseif(NOT EXISTS "${a_SOURCE_DIR}/.git")
        set(git_problem "${a_SOURCE_DIR} is not a git checkout")
    else()
        execute_process(
            COMMAND "${CMAKE_COMMAND}" -E env --unset=GIT_DIR --unset=GIT_WORK_TREE
                    --unset=GIT_INDEX_FILE --unset=GIT_CEILING_DIRECTORIES
                    "${git}" -C "${a_SOURCE_DIR}" describe --tags --dirty --abbrev=7
                    --match "v[0-9]*.[0-9]*.[0-9]*" --exclude "v*[!0-9.]*"
            RESULT_VARIABLE code OUTPUT_VARIABLE describe ERROR_VARIABLE describe_error
            OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_STRIP_TRAILING_WHITESPACE)
        if(code EQUAL 0)
            updater_version_from_describe("${describe}" git_full git_core)
            if("${git_full}" STREQUAL "")
                set(git_problem "git describe gave '${describe}', which is not a version")
            endif()
        else()
            string(CONCAT git_problem "no version tag vMAJOR.MINOR.PATCH is reachable (a shallow "
                                      "checkout without tags?)")
        endif()
    endif()

    set(warning "")
    if(NOT "${a_OPTION}" STREQUAL "")
        updater_version_from_option("${a_OPTION}" full core)
        if("${full}" STREQUAL "")
            message(FATAL_ERROR "UPDATER_VERSION='${a_OPTION}' is not a version of the form "
                                "MAJOR.MINOR.PATCH (optionally with -pre-release and +build metadata)")
        endif()
        set(source "UPDATER_VERSION")
        if(NOT "${git_full}" STREQUAL "")
            string(CONCAT warning "UPDATER_VERSION=${a_OPTION} overrides the version from git "
                                  "(${git_full}); it stays in the cache of this build directory. "
                                  "Remove it with -DUPDATER_VERSION= to take the version from git.")
        endif()
    elseif(NOT "${git_full}" STREQUAL "")
        set(full "${git_full}")
        set(core "${git_core}")
        set(source "git describe")
    else()
        set(full "0.0.0+unknown")
        set(core "0.0.0")
        set(source "none")
        string(CONCAT warning "${git_problem}. The version is ${full}. Builds without git take the "
                              "version from -DUPDATER_VERSION=<MAJOR.MINOR.PATCH>.")
    endif()
    set(${a_FULL} "${full}" PARENT_SCOPE)
    set(${a_CORE} "${core}" PARENT_SCOPE)
    set(${a_WARNING} "${warning}" PARENT_SCOPE)
    if(DEFINED a_SOURCE)
        set(${a_SOURCE} "${source}" PARENT_SCOPE)
    endif()
endfunction()

if(NOT CMAKE_SCRIPT_MODE_FILE)
    set(UPDATER_VERSION "" CACHE STRING
        "Version of a build without git (MAJOR.MINOR.PATCH); empty: from the version tag (git describe)")
    cmake_path(GET CMAKE_CURRENT_LIST_DIR PARENT_PATH _updater_scripts_dir)
    cmake_path(GET _updater_scripts_dir PARENT_PATH _updater_source_dir)
    updater_determine_version(SOURCE_DIR "${_updater_source_dir}" OPTION "${UPDATER_VERSION}"
        FULL UPDATER_VERSION_FULL CORE UPDATER_VERSION_CORE WARNING _updater_version_warning
        SOURCE _updater_version_source)
    if(NOT "${_updater_version_warning}" STREQUAL "")
        message(WARNING "hitokoto-win-updater version: ${_updater_version_warning}")
    endif()
    message(STATUS "hitokoto-win-updater version ${UPDATER_VERSION_FULL} (from ${_updater_version_source})")
    unset(_updater_version_warning)
    unset(_updater_version_source)
    unset(_updater_scripts_dir)
    unset(_updater_source_dir)
endif()
